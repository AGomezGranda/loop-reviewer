{
	"name": "loop-reviewer-web",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.5.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"check": "biome check && tsc --noEmit",
		"format": "biome format --write",
		"api:generate": "node scripts/generate-api.mjs",
		"api:check": "node scripts/generate-api.mjs --check",
		"architecture:check": "depcruise --config dependency-cruiser.cjs src",
		"test": "vitest run src",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@tanstack/react-query": "^5.108.2",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"lucide-react": "^1.77.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.2",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/vite": "4.3.5",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.13",
		"@types/node": "26.6.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.3.0",
		"dependency-cruiser": "^18.8.0",
		"jsdom": "^31.0.1",
		"openapi-typescript": "^7.13.0",
		"shadcn": "4.23.0",
		"tailwindcss": "4.3.5",
		"typescript": "5.9.3",
		"vite": "8.3.8",
		"vitest": "^5.1.1"
	}
}
