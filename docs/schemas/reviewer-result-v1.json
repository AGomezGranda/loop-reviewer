{
  "$defs": {
    "CompleteInventory": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "maximum": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "policy_version": {
          "maximum": 1,
          "minimum": 1,
          "title": "Policy Version",
          "type": "integer"
        },
        "comparison": {
          "$ref": "#/$defs/PinnedComparison"
        },
        "scope": {
          "const": "inventory",
          "title": "Scope",
          "type": "string"
        },
        "recommendation": {
          "const": "none",
          "title": "Recommendation",
          "type": "string"
        },
        "discussion_status": {
          "const": "not_requested",
          "title": "Discussion Status",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/InventoryUsage"
        },
        "investigation_coverage": {
          "maxItems": 0,
          "minItems": 0,
          "title": "Investigation Coverage",
          "type": "array"
        },
        "evidence_index": {
          "maxItems": 0,
          "minItems": 0,
          "title": "Evidence Index",
          "type": "array"
        },
        "findings": {
          "maxItems": 0,
          "minItems": 0,
          "title": "Findings",
          "type": "array"
        },
        "private_leads": {
          "maxItems": 0,
          "minItems": 0,
          "title": "Private Leads",
          "type": "array"
        },
        "linked_existing_threads": {
          "maxItems": 0,
          "minItems": 0,
          "title": "Linked Existing Threads",
          "type": "array"
        },
        "status": {
          "const": "complete",
          "title": "Status",
          "type": "string"
        },
        "stop_reason": {
          "const": "finished",
          "title": "Stop Reason",
          "type": "string"
        },
        "error": {
          "title": "Error",
          "type": "null"
        },
        "file_coverage": {
          "items": {
            "$ref": "#/$defs/FileCoverage"
          },
          "maxItems": 10000,
          "title": "File Coverage",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "policy_version",
        "comparison",
        "scope",
        "recommendation",
        "discussion_status",
        "usage",
        "investigation_coverage",
        "evidence_index",
        "findings",
        "private_leads",
        "linked_existing_threads",
        "status",
        "stop_reason",
        "error",
        "file_coverage"
      ],
      "title": "CompleteInventory",
      "type": "object"
    },
    "FailedInventory": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "maximum": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "policy_version": {
          "maximum": 1,
          "minimum": 1,
          "title": "Policy Version",
          "type": "integer"
        },
        "comparison": {
          "$ref": "#/$defs/PinnedComparison"
        },
        "scope": {
          "const": "inventory",
          "title": "Scope",
          "type": "string"
        },
        "recommendation": {
          "const": "none",
          "title": "Recommendation",
          "type": "string"
        },
        "discussion_status": {
          "const": "not_requested",
          "title": "Discussion Status",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/InventoryUsage"
        },
        "investigation_coverage": {
          "maxItems": 0,
          "minItems": 0,
          "title": "Investigation Coverage",
          "type": "array"
        },
        "evidence_index": {
          "maxItems": 0,
          "minItems": 0,
          "title": "Evidence Index",
          "type": "array"
        },
        "findings": {
          "maxItems": 0,
          "minItems": 0,
          "title": "Findings",
          "type": "array"
        },
        "private_leads": {
          "maxItems": 0,
          "minItems": 0,
          "title": "Private Leads",
          "type": "array"
        },
        "linked_existing_threads": {
          "maxItems": 0,
          "minItems": 0,
          "title": "Linked Existing Threads",
          "type": "array"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "stop_reason": {
          "enum": [
            "work_limit",
            "fatal_error"
          ],
          "title": "Stop Reason",
          "type": "string"
        },
        "error": {
          "$ref": "#/$defs/InventoryError"
        },
        "file_coverage": {
          "maxItems": 0,
          "minItems": 0,
          "title": "File Coverage",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "policy_version",
        "comparison",
        "scope",
        "recommendation",
        "discussion_status",
        "usage",
        "investigation_coverage",
        "evidence_index",
        "findings",
        "private_leads",
        "linked_existing_threads",
        "status",
        "stop_reason",
        "error",
        "file_coverage"
      ],
      "title": "FailedInventory",
      "type": "object"
    },
    "FileCoverage": {
      "additionalProperties": false,
      "properties": {
        "change_type": {
          "enum": [
            "added",
            "deleted",
            "modified",
            "renamed",
            "type_changed"
          ],
          "title": "Change Type",
          "type": "string"
        },
        "old": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "new": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "added_lines": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Added Lines"
        },
        "deleted_lines": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deleted Lines"
        },
        "binary": {
          "title": "Binary",
          "type": "boolean"
        },
        "oversized": {
          "title": "Oversized",
          "type": "boolean"
        },
        "outcome": {
          "const": "complete",
          "title": "Outcome",
          "type": "string"
        },
        "highest_completed_check": {
          "const": "inventory_only",
          "title": "Highest Completed Check",
          "type": "string"
        },
        "required_investigation_ids": {
          "maxItems": 0,
          "minItems": 0,
          "title": "Required Investigation Ids",
          "type": "array"
        }
      },
      "required": [
        "change_type",
        "old",
        "new",
        "added_lines",
        "deleted_lines",
        "binary",
        "oversized",
        "outcome",
        "highest_completed_check",
        "required_investigation_ids"
      ],
      "title": "FileCoverage",
      "type": "object"
    },
    "FileSide": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 12288,
          "minLength": 1,
          "pattern": "^(?:[A-Za-z0-9._~/\\-]|%[0-9A-F]{2})+$",
          "title": "Path",
          "type": "string"
        },
        "object_id": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Object Id",
          "type": "string"
        },
        "mode": {
          "enum": [
            "100644",
            "100755",
            "120000",
            "160000"
          ],
          "title": "Mode",
          "type": "string"
        },
        "blob_bytes": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blob Bytes"
        },
        "generated": {
          "enum": [
            "marked",
            "unmarked",
            "unknown"
          ],
          "title": "Generated",
          "type": "string"
        }
      },
      "required": [
        "path",
        "object_id",
        "mode",
        "blob_bytes",
        "generated"
      ],
      "title": "FileSide",
      "type": "object"
    },
    "InventoryError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "invalid_repository",
            "git_unavailable",
            "missing_commit",
            "invalid_comparison",
            "invalid_inventory",
            "git_error",
            "work_limit"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "InventoryError",
      "type": "object"
    },
    "InventoryUsage": {
      "additionalProperties": false,
      "properties": {
        "model_calls": {
          "maximum": 0,
          "minimum": 0,
          "title": "Model Calls",
          "type": "integer"
        },
        "input_tokens": {
          "maximum": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "maximum": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "estimated_cost_usd_micros": {
          "maximum": 0,
          "minimum": 0,
          "title": "Estimated Cost Usd Micros",
          "type": "integer"
        },
        "unaccounted_reserved_usd_micros": {
          "maximum": 0,
          "minimum": 0,
          "title": "Unaccounted Reserved Usd Micros",
          "type": "integer"
        }
      },
      "required": [
        "model_calls",
        "input_tokens",
        "output_tokens",
        "estimated_cost_usd_micros",
        "unaccounted_reserved_usd_micros"
      ],
      "title": "InventoryUsage",
      "type": "object"
    },
    "PinnedComparison": {
      "additionalProperties": false,
      "properties": {
        "merge_base": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Merge Base",
          "type": "string"
        },
        "head": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Head",
          "type": "string"
        }
      },
      "required": [
        "merge_base",
        "head"
      ],
      "title": "PinnedComparison",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "complete": "#/$defs/CompleteInventory",
      "failed": "#/$defs/FailedInventory"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/CompleteInventory"
    },
    {
      "$ref": "#/$defs/FailedInventory"
    }
  ],
  "title": "ReviewerResult"
}
