{
  "$defs": {
    "InventoryBudget": {
      "additionalProperties": false,
      "properties": {
        "max_model_spend_usd_micros": {
          "maximum": 3000000,
          "minimum": 0,
          "title": "Max Model Spend Usd Micros",
          "type": "integer"
        }
      },
      "required": [
        "max_model_spend_usd_micros"
      ],
      "title": "InventoryBudget",
      "type": "object"
    },
    "PinnedComparison": {
      "additionalProperties": false,
      "properties": {
        "merge_base": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Merge Base",
          "type": "string"
        },
        "head": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Head",
          "type": "string"
        }
      },
      "required": [
        "merge_base",
        "head"
      ],
      "title": "PinnedComparison",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "const": "inventory",
      "title": "Scope",
      "type": "string"
    },
    "comparison": {
      "$ref": "#/$defs/PinnedComparison"
    },
    "budget": {
      "$ref": "#/$defs/InventoryBudget"
    },
    "discussion": {
      "title": "Discussion",
      "type": "null"
    }
  },
  "required": [
    "schema_version",
    "scope",
    "comparison",
    "budget",
    "discussion"
  ],
  "title": "ReviewerRequest",
  "type": "object"
}
